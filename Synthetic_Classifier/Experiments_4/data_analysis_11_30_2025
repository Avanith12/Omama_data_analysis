   "source": [
    "n = 200\n",
    "batch_size = 12\n",
    "n_batches = (n + batch_size - 1) // batch_size\n",
    "\n",
    "for b in range(n_batches):\n",
    "    start = b * batch_size\n",
    "    end = min(start + batch_size, n, len(orig_files), len(synth_files))\n",
    "    \n",
    "    if start >= end:\n",
    "        break\n",
    "    \n",
    "    size = end - start\n",
    "    fig, ax = plt.subplots(size, 2, figsize=(16, 2.5*size))\n",
    "    \n",
    "    if size == 1:\n",
    "        ax = ax.reshape(1, -1)\n",
    "    \n",
    "    for j in range(size):\n",
    "        i = start + j\n",
    "        if i >= len(orig_files) or i >= len(synth_files):\n",
    "            break\n",
    "        \n",
    "        orig = cv2.imread(os.path.join(orig_path, orig_files[i]), cv2.IMREAD_GRAYSCALE)\n",
    "        synth = cv2.imread(os.path.join(synth_path, synth_files[i]), cv2.IMREAD_GRAYSCALE)\n",
    "        \n",
    "        ax[j, 0].imshow(orig, cmap='gray')\n",
    "        ax[j, 0].set_title(f'Original\\n{orig_files[i]}', fontsize=10, color='white')\n",
    "        ax[j, 0].axis('off')\n",
    "        ax[j, 0].set_facecolor('black')\n",
    "        \n",
    "        ax[j, 1].imshow(synth, cmap='gray')\n",
    "        ax[j, 1].set_title(f'Synthetic\\n{synth_files[i]}', fontsize=10, color='white')\n",
    "        ax[j, 1].axis('off')\n",
    "        ax[j, 1].set_facecolor('black')\n",
    "    \n",
    "    fig.patch.set_facecolor('black')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
  }
